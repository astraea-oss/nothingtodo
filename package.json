{
  "name": "nothingtodo",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "test:core": "cargo test -p nothingtodo-core",
    "test:sync": "node scripts/test-sync.mjs",
    "package:linux": "node scripts/package-linux.mjs",
    "package:android": "node scripts/package-android.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^8.0.16",
    "typescript": "~6.0.3"
  }
}
